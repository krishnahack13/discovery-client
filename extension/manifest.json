{
  "manifest_version": 3,
  "name": "Shadow AI Monitor",
  "version": "1.0",
  "permissions": [
    "storage",
    "alarms",
    "downloads"
  ],
  "host_permissions": [
    "<all_urls>",
    "http://localhost:8078/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content_script.js"
      ],
      "run_at": "document_start"
    }
  ],
  "background": {
    "service_worker": "background.js"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "injected.js"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}